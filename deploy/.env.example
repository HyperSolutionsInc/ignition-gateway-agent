# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# --- Docker wiring (match the Ignition stack) ---
IGNITION_NETWORK=ignition-stack_datacenter-net
IGNITION_DATA_VOLUME=ignition-stack_ignition-data
IOT_CERT_DIR=./certs
AGENT_PUBLISH_ADDR=127.0.0.1

# --- Ignition ---
IGNITION_URL=http://ignition:8088
# Gateway webpage > Security > API Keys. Needs permission to import tags and scan projects.
IGNITION_API_TOKEN=
IGNITION_PROJECT=hyper-gateway
IGNITION_TAG_PROVIDER=default
# Optional folder under the provider that every IMS tree is placed beneath.
IGNITION_TAG_ROOT=
# customer / campus / building / power cell
IMS_PATH_DEPTH=4
TIMER_INTERVAL_MS=1000
AGENT_URL_FOR_IGNITION=http://gateway-agent:8600

# --- AWS IoT Core ---
IOT_ENABLED=true
IOT_ENDPOINT=a27n1c51bedgc5-ats.iot.us-east-2.amazonaws.com
IOT_PORT=8883
# One thing per gateway; also used as the MQTT client id unless IOT_CLIENT_ID is set.
IOT_THING_NAME=
IOT_CLIENT_ID=
IOT_CA_PATH=/certs/AmazonRootCA1.pem
IOT_CERT_PATH=/certs/device.cert.pem
IOT_KEY_PATH=/certs/device.private.key
IOT_TELEMETRY_TOPIC=hyper/gateways/{thing}/ims/{ims}/telemetry
SHADOW_ENABLED=true
HEALTH_INTERVAL_S=60
ALLOW_REMOTE_RESTART=false

# --- Buffering ---
BUFFER_MAX_ROWS=5000000
